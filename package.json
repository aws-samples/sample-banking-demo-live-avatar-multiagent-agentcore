{
    "name": "PROJECT-IDENTIFIER",
    "description": "project description",
    "version": "3.0.1",
    "author": "GenAI Labs Team",
    "license": "Apache License Version 2.0",
    "private": true,
    "workspaces": [
        "src/*"
    ],
    "scripts": {
        "setup": "uv venv --allow-existing && uv pip install -r requirements-dev.txt && npm config set registry=https://registry.npmjs.com/ && npm install && cd ./src/backend && npm install && cd ../frontend && npm install",
        "prepare": "husky",
        "configure": "npx tsx tools/cli/configure.ts",
        "format": "prettier --write . && uv run ruff format .",
        "lint": "eslint . && uv run ruff check .",
        "develop": "npx tsx tools/cli/develop.ts",
        "stage": "npx generate-changelog && git add -A",
        "commit": "npx cz",
        "clean": "npx npkill -nu -D -y"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix-dry-run"
        ],
        "*.{json,yaml,yml,md,html,css}": [
            "prettier --write"
        ],
        "*.py": [
            "uv run ruff format",
            "uv run ruff check"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "engines": {
        "node": "22.8.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@commitlint/prompt-cli": "^19.8.1",
        "@commitlint/types": "^19.8.1",
        "@types/node": "22.7.9",
        "@typescript-eslint/eslint-plugin": "^8.25.0",
        "@typescript-eslint/parser": "^8.25.0",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "globals": "^15.15.0",
        "husky": "^9.1.6",
        "lint-staged": "^15.5.2",
        "prettier": "^3.6.2",
        "tsx": "^4.20.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.25.0"
    },
    "dependencies": {
        "@aws-sdk/client-cloudformation": "^3.848.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.848.0",
        "@aws-sdk/credential-providers": "^3.848.0",
        "chalk": "4.1.0",
        "enquirer": "^2.4.1",
        "node-email-verifier": "^2.0.0",
        "yaml": "^2.8.0",
        "zod": "^3.25.76"
    }
}
