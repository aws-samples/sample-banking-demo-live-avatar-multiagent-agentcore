{
    "name": "gartner-appdev-2026",
    "description": "Gartner AppDev 2026 Research Agent Demo",
    "version": "5.0.0",
    "author": "AWS Marketing Demo Engineering",
    "license": "Apache License Version 2.0",
    "private": true,
    "bin": {
        "app": "bin/app.js"
    },
    "workspaces": [
        "lib/stacks/frontend/app"
    ],
    "scripts": {
        "preinstall": "npm config set registry=https://registry.npmjs.com/",
        "postinstall": "uv venv --allow-existing && uv tool install ruff && find lib patterns -name 'requirements.txt' -exec uv pip install -r {} \\; && uv pip install pytest pip && uv pip install -r tools/generative-architecture/requirements.txt",
        "prepare": "husky",
        "format": "prettier --write . && ruff format .",
        "lint": "eslint . && ruff check .",
        "kit": "npx tsx tools/kit.ts",
        "export": "npx tsx tools/export.ts",
        "diagram": "npx tsx tools/diagram.ts",
        "docs:export": "./.venv/bin/python tools/docs-export/build.py",
        "docs:script": "./.venv/bin/python tools/demo-script/build_docx.py",
        "stage": "git add -A",
        "commit": "npx cz",
        "build": "tsc",
        "watch": "tsc -w",
        "test": "jest",
        "test:python": "./.venv/bin/pytest",
        "cdk": "npx aws-cdk@2.1121.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix-dry-run"
        ],
        "*.{json,yaml,yml,md,html,css}": [
            "prettier --write"
        ],
        "*.py": [
            "ruff format",
            "ruff check"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "engines": {
        "node": "22.8.0"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudformation": "^3.1000.0",
        "@aws-sdk/credential-providers": "^3.1000.0",
        "@inquirer/prompts": "^8.3.0",
        "@types/archiver": "^7.0.0",
        "@types/aws-lambda": "^8.10.161",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.3.3",
        "archiver": "^7.0.1",
        "aws-cdk": "^2.1121.0",
        "chalk": "4.1.2",
        "commander": "^14.0.3",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^9.39.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "fast-check": "4.9.0",
        "globals": "^17.4.0",
        "husky": "^9.1.6",
        "jest": "^30.2.0",
        "lint-staged": "^16.3.1",
        "prettier": "^3.8.1",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.56.1",
        "yaml": "^2.8.2"
    },
    "overrides": {
        "minimatch": "9.0.5",
        "hono": "4.12.18",
        "@hono/node-server": "1.19.14",
        "express-rate-limit": "8.3.0"
    },
    "dependencies": {
        "@aws-cdk/aws-bedrock-alpha": "^2.253.1-alpha.0",
        "@aws-cdk/aws-lambda-python-alpha": "^2.253.1-alpha.0",
        "@aws-lambda-powertools/event-handler": "^2.31.0",
        "@aws-lambda-powertools/logger": "^2.31.0",
        "@aws-lambda-powertools/parameters": "^2.31.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.1000.0",
        "@aws-sdk/client-secrets-manager": "^3.1000.0",
        "@aws/pdk": "^0.26.15",
        "@cdklabs/deploy-time-build": "^0.0.7",
        "@cdklabs/generative-ai-cdk-constructs": "^0.1.314",
        "aws-appsync": "^4.1.10",
        "aws-cdk-lib": "^2.253.1",
        "cdk-nag": "^2.37.55",
        "constructs": "^10.4.5",
        "ob-appsync-events-request": "^0.0.7"
    }
}
