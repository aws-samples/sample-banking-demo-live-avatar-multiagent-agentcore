{
    "name": "PROJECT-IDENTIFIER",
    "description": "PROJECT-DESCRIPTION",
    "version": "5.0.0",
    "author": "AWS Technical Product Marketing",
    "license": "Apache License Version 2.0",
    "private": true,
    "bin": {
        "app": "bin/app.js"
    },
    "workspaces": [
        "lib/stacks/frontend/app"
    ],
    "scripts": {
        "preinstall": "npm config set registry=https://registry.npmjs.com/",
        "postinstall": "uv venv --allow-existing && uv tool install ruff",
        "prepare": "husky",
        "format": "prettier --write . && ruff format .",
        "lint": "eslint . && ruff check .",
        "kit": "npx tsx tools/kit.ts",
        "export": "npx tsx tools/export.ts",
        "stage": "npx generate-changelog && git add -A",
        "commit": "npx cz",
        "build": "tsc",
        "watch": "tsc -w",
        "test": "jest",
        "cdk": "npx aws-cdk@2.1029.4"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix-dry-run"
        ],
        "*.{json,yaml,yml,md,html,css}": [
            "prettier --write"
        ],
        "*.py": [
            "ruff format",
            "ruff check"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "engines": {
        "node": "22.8.0"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudformation": "^3.901.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.901.0",
        "@aws-sdk/client-secrets-manager": "^3.901.0",
        "@aws-sdk/credential-providers": "^3.901.0",
        "@inquirer/prompts": "^7.8.6",
        "@types/archiver": "^6.0.3",
        "@types/aws-lambda": "^8.10.153",
        "@types/jest": "^30.0.0",
        "@types/node": "24.6.1",
        "@typescript-eslint/eslint-plugin": "^8.37.0",
        "@typescript-eslint/parser": "^8.37.0",
        "archiver": "^7.0.1",
        "aws-cdk": "^2.1029.4",
        "chalk": "4.1.2",
        "commander": "^14.0.0",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^9.36.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.4.0",
        "husky": "^9.1.6",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.3",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.4",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.45.0",
        "yaml": "^2.8.0"
    },
    "dependencies": {
        "@aws-amplify/data-construct": "^1.16.3",
        "@aws-cdk/aws-bedrock-alpha": "^2.214.1-alpha.0",
        "@aws-cdk/aws-lambda-python-alpha": "^2.214.1-alpha.0",
        "@aws/pdk": "^0.26.14",
        "@cdklabs/generative-ai-cdk-constructs": "^0.1.309",
        "aws-appsync": "^4.1.10",
        "aws-cdk-lib": "^2.219.0",
        "cdk-nag": "^2.37.40",
        "constructs": "^10.4.2",
        "deploy-time-build": "^0.4.1"
    }
}
