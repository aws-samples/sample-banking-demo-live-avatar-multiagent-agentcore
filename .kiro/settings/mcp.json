{
    "@export": { "deleteFile": true },
    "mcpServers": {
        "fetch": {
            "command": "uvx",
            "args": ["mcp-fetch@latest"],
            "disabled": false,
            "autoApprove": ["fetch"]
        },
        "aws-knowledge": {
            "command": "uvx",
            "args": ["fastmcp", "run", "https://knowledge-mcp.global.api.aws"],
            "disabled": false,
            "autoApprove": [
                "aws___get_regional_availability",
                "aws___list_regions",
                "aws___read_documentation",
                "aws___recommend",
                "aws___search_documentation"
            ]
        },
        "aws-iac": {
            "command": "uvx",
            "args": ["awslabs.aws-iac-mcp-server@latest"],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR"
            },
            "disabled": false,
            "autoApprove": [
                "search_cdk_documentation",
                "read_iac_documentation_page",
                "search_cdk_samples_and_constructs",
                "cdk_best_practices",
                "troubleshoot_cloudformation_deployment",
                "check_cloudformation_template_compliance"
            ]
        },
        "strands-agents": {
            "command": "uvx",
            "args": ["strands-agents-mcp-server"],
            "env": {
                "FASTMCP_LOG_LEVEL": "INFO"
            },
            "disabled": false,
            "autoApprove": ["search_docs", "fetch_doc"]
        },
        "bedrock-agentcore": {
            "command": "uvx",
            "args": ["awslabs.amazon-bedrock-agentcore-mcp-server@latest"],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR"
            },
            "disabled": false,
            "autoApprove": ["search_agentcore_docs", "fetch_agentcore_doc"]
        },
        "frontend": {
            "command": "uvx",
            "args": ["awslabs.frontend-mcp-server@latest"],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR"
            },
            "disabled": false,
            "autoApprove": ["GetReactDocsByTopic"]
        },
        "cloudwatch": {
            "command": "uvx",
            "args": ["awslabs.cloudwatch-mcp-server@latest"],
            "disabled": false
        },
        "playwright": {
            "command": "npx",
            "args": ["@playwright/mcp@latest", "--extension"],
            "disabled": false,
            "autoApprove": [
                "browser_close",
                "browser_resize",
                "browser_console_messages",
                "browser_handle_dialog",
                "browser_fill_form",
                "browser_press_key",
                "browser_type",
                "browser_navigate",
                "browser_navigate_back",
                "browser_network_requests",
                "browser_take_screenshot",
                "browser_snapshot",
                "browser_click",
                "browser_drag",
                "browser_hover",
                "browser_select_option",
                "browser_tabs",
                "browser_wait_for"
            ]
        },
        "aws-diagram": {
            "command": "uvx",
            "args": ["awslabs.aws-diagram-mcp-server"],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR"
            },
            "disabled": false,
            "autoApprove": ["generate_diagram", "get_diagram_examples", "list_icons"]
        },
        "synthetic-data": {
            "command": "uvx",
            "args": ["awslabs.syntheticdata-mcp-server"],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR"
            },
            "disabled": true,
            "autoApprove": ["get_data_gen_instructions", "validate_and_save_data"]
        }
    }
}
