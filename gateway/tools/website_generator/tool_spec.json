[
    {
        "name": "website_generator",
        "description": "Generate or update a static website on S3 for ANY topic. Returns a presigned URL to view the site. Layouts: 'article' (research reports, long-form content), 'landing' (product/topic pages with hero + sections), 'menu' (a card-grid catalog layout with prices and badges, used by the Services Catalog pipeline). For ad-hoc content prefer 'article' or 'landing'. Three modes: 'create' builds from structured content. 'update' with 'html' uploads agent-generated HTML. 'update' with 'edit_instructions' fetches the current site and applies changes via AI.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": ["create", "update", "add_images"],
                    "default": "create",
                    "description": "'create' to build from content, 'update' to modify an existing site, 'add_images' to attach images to items on an existing site"
                },
                "layout": {
                    "type": "string",
                    "enum": ["article", "landing", "menu"],
                    "default": "article",
                    "description": "Output layout. 'article' = research report / long-form (default for research topics). 'landing' = hero + feature sections (use for bank product overviews). 'menu' = card-grid catalog with prices/badges (used by the Services Catalog pipeline). For ad-hoc content prefer 'article' or 'landing'."
                },
                "title": {
                    "type": "string",
                    "description": "Website title (required for create)"
                },
                "content": {
                    "type": "object",
                    "description": "Generic content for 'article' or 'landing' layouts. Use this for reports, product overviews, and topic pages.",
                    "properties": {
                        "subtitle": {
                            "type": "string",
                            "description": "Optional hero subtitle / tagline"
                        },
                        "sections": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "heading": { "type": "string" },
                                    "body": {
                                        "type": "string",
                                        "description": "Paragraph text (plain text or simple HTML). Supports \\n for paragraph breaks."
                                    },
                                    "items": {
                                        "type": "array",
                                        "description": "Optional list of items/features under this section (for landing layouts).",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "name": { "type": "string" },
                                                "description": { "type": "string" },
                                                "s3_key": { "type": "string" },
                                                "image_url": { "type": "string" }
                                            },
                                            "required": ["name"]
                                        }
                                    }
                                },
                                "required": ["heading"]
                            }
                        }
                    }
                },
                "menu": {
                    "type": "object",
                    "description": "Card-grid catalog content with sections and items (name, description, price, badges). Use only when layout='menu'. Used by the Services Catalog pipeline to render product cards.",
                    "properties": {
                        "title": { "type": "string" },
                        "sections": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "name": { "type": "string" },
                                                "description": { "type": "string" },
                                                "price": { "type": "string" },
                                                "dietary": {
                                                    "type": "array",
                                                    "items": { "type": "string" }
                                                },
                                                "s3_key": { "type": "string" },
                                                "image_url": { "type": "string" }
                                            },
                                            "required": ["name"]
                                        }
                                    }
                                },
                                "required": ["name", "items"]
                            }
                        }
                    }
                },
                "s3_key": {
                    "type": "string",
                    "description": "S3 key of the existing website to update (required for update)"
                },
                "html": {
                    "type": "string",
                    "description": "Complete HTML to upload directly (for update mode when the agent generates HTML itself)"
                },
                "edit_instructions": {
                    "type": "string",
                    "description": "Natural language description of changes to apply (for update mode). The tool fetches the current site and applies changes via AI. Use this when you cannot generate HTML yourself."
                },
                "images": {
                    "type": "array",
                    "description": "Array of images to add to the website (for add_images mode). Each item has 'name' (item/section name to match) and 's3_key' or 'image_url'.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Item or section name to match in the website"
                            },
                            "s3_key": { "type": "string", "description": "S3 key of the image" },
                            "image_url": {
                                "type": "string",
                                "description": "Presigned URL of the image (fallback)"
                            }
                        },
                        "required": ["name"]
                    }
                },
                "user_id": {
                    "type": "string",
                    "description": "Authenticated user identifier (injected by runtime)"
                }
            },
            "required": []
        }
    }
]
